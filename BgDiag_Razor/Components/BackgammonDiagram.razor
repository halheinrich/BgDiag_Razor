@if (_svgMarkup is not null)
{
    <div class="bg-diagram" style="@_rootStyle" @attributes="AdditionalAttributes">
        <div style="pointer-events: none;">
            @((MarkupString)_svgMarkup)
        </div>
        @if (_hitRegions is not null)
        {
            <svg xmlns="http://www.w3.org/2000/svg"
                 viewBox="@_hitRegions.ViewBox.ToAttributeString()"
                 style="position: absolute; top: 0; left: 0; width: 100%; height: 100%;">
                @foreach (var kvp in _hitRegions.Points)
                {
                    var pt = kvp.Key;
                    var r = kvp.Value;
                    <rect x="@SvgFormat.Number(r.X)" y="@SvgFormat.Number(r.Y)" width="@SvgFormat.Number(r.Width)" height="@SvgFormat.Number(r.Height)"
                          fill="transparent" pointer-events="all"
                          @onclick="() => OnPointClicked.InvokeAsync(pt)" />
                }
                @{
                    var bar = _hitRegions.Bar;
                }
                <rect x="@SvgFormat.Number(bar.X)" y="@SvgFormat.Number(bar.Y)" width="@SvgFormat.Number(bar.Width)" height="@SvgFormat.Number(bar.Height)"
                      fill="transparent" pointer-events="all"
                      @onclick="() => OnBarClicked.InvokeAsync(25)" />
                @if (_hitRegions.OnRollTray is { } tray)
                {
                    <rect x="@SvgFormat.Number(tray.X)" y="@SvgFormat.Number(tray.Y)" width="@SvgFormat.Number(tray.Width)" height="@SvgFormat.Number(tray.Height)"
                          fill="transparent" pointer-events="all"
                          @onclick="OnTrayClicked" />
                }
                @if (_hitRegions.Dice is { } dice)
                {
                    <rect x="@SvgFormat.Number(dice.X)" y="@SvgFormat.Number(dice.Y)" width="@SvgFormat.Number(dice.Width)" height="@SvgFormat.Number(dice.Height)"
                          fill="transparent" pointer-events="all"
                          @onclick="OnDiceClicked" />
                }
            </svg>
        }
        @if (Overlay is not null)
        {
            <div class="bg-diagram-overlay" style="position: absolute; inset: 0; pointer-events: none;">
                @Overlay
            </div>
        }
    </div>
}
