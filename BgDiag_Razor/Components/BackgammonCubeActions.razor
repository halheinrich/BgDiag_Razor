<div class="bg-cube-actions" role="radiogroup" aria-label="Cube decision" @attributes="AdditionalAttributes">
    @foreach (var answer in _offeredAnswers)
    {
        var label = CubeLabels.Label(answer, Decision);
        var selected = Value == answer;
        <label class="bg-cube-action@(selected ? " bg-cube-action-selected" : "")" title="@label">
            <input type="radio"
                   name="@_groupName"
                   value="@label"
                   aria-label="@AccessibleNameOf(answer)"
                   checked="@selected"
                   @onchange="() => HandleSelected(answer)" />
            @CaptionOf(answer)
        </label>
    }
</div>
