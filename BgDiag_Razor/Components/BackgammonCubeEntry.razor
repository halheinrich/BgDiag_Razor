@if (Request is not null)
{
    <div class="bg-cube-entry" @attributes="AdditionalAttributes">
        <div class="bg-board-slot">
            <BackgammonDiagram Request="Request" Options="Options" Overlay="Overlay" />
        </div>
        <div class="bg-cube-actions" role="radiogroup" aria-label="Cube decision">
            @foreach (var (label, pair) in _cubeOptions)
            {
                var selected = _selection == pair;
                <label class="bg-cube-action@(selected ? " bg-cube-action-selected" : "")">
                    <input type="radio"
                           name="bg-cube-action"
                           value="@label"
                           checked="@selected"
                           @onchange="() => HandleCubeOptionSelected(pair)" />
                    @label
                </label>
            }
        </div>
    </div>
}
