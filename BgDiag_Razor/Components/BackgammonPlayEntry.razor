@if (_renderedRequest is not null)
{
    <div class="bg-play-entry" @attributes="AdditionalAttributes">
        <div class="bg-board-slot">
            <BackgammonDiagram Request="_renderedRequest"
                               Options="Options"
                               Overlay="Overlay"
                               OnPointClicked="HandlePointClick"
                               OnBarClicked="HandleBarClick"
                               OnTrayClicked="HandleTrayClick"
                               OnDiceClicked="HandleDiceClick" />
        </div>
    </div>
}
